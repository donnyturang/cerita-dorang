{{- $pages := where site.RegularPages "Section" "posts" -}}
[
{{- range $i, $e := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "title": {{ $e.Title | jsonify }},
    "permalink": {{ $e.RelPermalink | jsonify }},
    "summary": {{ $e.Summary | plainify | truncate 200 | jsonify }},
    "date": {{ $e.Date.Format "2 January 2006" | jsonify }},
    "tags": {{ $e.Params.tags | jsonify }},
    "categories": {{ $e.Params.categories | jsonify }}
  }
{{- end -}}
]
